# RenderFlow 后端配置（复制为 .env 使用；真实 .env 不提交）
# SQLite 数据库文件路径
RENDERFLOW_DB_PATH=./data/renderflow.db
# 输出文件与日志的根目录（任务产物落在 {DATA_DIR}/tasks/... 下）
RENDERFLOW_DATA_DIR=./data
# JSON 行式事件文件日志目录
RENDERFLOW_LOG_DIR=./data/logs
# Worker 空轮询间隔（毫秒）
RENDERFLOW_POLL_INTERVAL_MS=300
# MOCK 步骤默认执行时长（毫秒），任务创建 payload 的 step_durations 可按步骤覆盖
RENDERFLOW_STEP_DURATION_MS=800
# 步骤租约时长（秒），超时未续租视为 Worker 失联
RENDERFLOW_LEASE_SECONDS=15
# 心跳续租间隔（秒）
RENDERFLOW_HEARTBEAT_SECONDS=5
# 重试指数退避基准/上限（秒），实际退避 = min(base*2^(n-1), max) + 抖动
RENDERFLOW_RETRY_BACKOFF_BASE_S=1
RENDERFLOW_RETRY_BACKOFF_MAX_S=30
# 结果缓存 TTL（秒）；关闭缓存设 0
RENDERFLOW_CACHE_TTL_SECONDS=86400
# 结果缓存开关（1 开 / 0 关）
RENDERFLOW_CACHE_ENABLED=1
# 故障注入生效门（仅测试/演示用，生产保持 0）
RENDERFLOW_ALLOW_FAULT_INJECTION=0
# ── 真实 LLM 节点（analyze_scenes；OpenAI 兼容 chat/completions）──
# 三项都配置时启用真实调用；任一为空则自动 Mock 模式（结果明确标记 llm_source=mock）
# 例（GLM）: RENDERFLOW_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 例（OpenAI）: RENDERFLOW_LLM_BASE_URL=https://api.openai.com/v1
RENDERFLOW_LLM_BASE_URL=
RENDERFLOW_LLM_MODEL=
# API Key 只经环境变量注入，绝不写进代码或提交 Git
RENDERFLOW_LLM_API_KEY=
# 单次调用超时（秒）
RENDERFLOW_LLM_TIMEOUT_S=60
# LLM 节点内部重试次数（限流/超时/非法输出；步骤级重试另算）
RENDERFLOW_LLM_MAX_ATTEMPTS=2
